# Managed by the `docker` Ansible role -- ansible/playbooks/roles/docker.
# Do not edit on the host: the next run overwrites this file.
#
# Non-secret values are defaults in roles/docker/defaults/main.yml
# (docker_env_values). The three secret values are injected from Gitea Actions
# secrets at apply time and are never committed. If any secret is absent the
# role leaves the existing file untouched rather than writing blanks.
#
# PUID/PGID are literal '${PUID:-1000}' strings, reproduced exactly as they were
# on the host. Docker Compose does not shell-expand env_file values, so the
# containers receive that literal text; "fixing" it here would change what the
# containers actually get.
TZ={{ docker_env_values['TZ'] }}
CONFIG_FILE={{ docker_env_values['CONFIG_FILE'] }}
GITEA_INSTANCE_URL={{ docker_env_values['GITEA_INSTANCE_URL'] }}

# gitea-runner
GITEA_RUNNER_REGISTRATION_TOKEN={{ docker_workload_secrets['DOCKER_GITEA_RUNNER_REGISTRATION_TOKEN'] }}

# garage
GARAGE_RPC_SECRET={{ docker_workload_secrets['DOCKER_GARAGE_RPC_SECRET'] }}

# lidarr
PUID={{ docker_env_values['PUID'] }}
PGID={{ docker_env_values['PGID'] }}

# slskd (service disabled in the compose file; settings kept so re-enabling is
# just an uncomment)
SLSKD_SLSK_USERNAME={{ docker_env_values['SLSKD_SLSK_USERNAME'] }}
SLSKD_SLSK_PASSWORD={{ docker_workload_secrets['DOCKER_SLSKD_SLSK_PASSWORD'] }}
SLSKD_REMOTE_CONFIGURATION={{ docker_env_values['SLSKD_REMOTE_CONFIGURATION'] }}

# soularr (service disabled in the compose file; inert but harmless to keep)
SCRIPT_INTERVAL={{ docker_env_values['SCRIPT_INTERVAL'] }}
WEBUI_ENABLED={{ docker_env_values['WEBUI_ENABLED'] }}