#!/usr/bin/env python3
import asyncio
import base64
import contextlib
import json
import logging
import math
import signal
import struct
from pathlib import Path

from aiosendspin.client import PairingSupport, SendspinClient
from aiosendspin.models.core import ServerCommandPayload
from aiosendspin.models.player import SupportedAudioFormat
from aiosendspin.models.source import ClientHelloSourceFeatures, ClientHelloSourceSupport
from aiosendspin.models.types import AudioCodec, Roles, SignalState
from aiosendspin.noise.keys import Identity
from aiosendspin.noise.trust_store import FileClientPairingStore

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(name)s %(levelname)s %(message)s")
logger = logging.getLogger("sendspin-source")

SERVER = "ws://{{ streamer_sendspin_server }}:{{ streamer_sendspin_port }}/sendspin"
ALSA_DEVICE = "{{ streamer_soundcard }}"
CLIENT_NAME = "{{ streamer_sendspin_client_name }}"
STATE_DIR = Path("{{ streamer_sendspin_state_dir }}")

SAMPLE_RATE = 48000
BIT_DEPTH = 16
CHANNELS = 2
CHUNK_BYTES = SAMPLE_RATE * CHANNELS * (BIT_DEPTH // 8) * 25 // 1000
FRAME_STRIDE = CHANNELS * (BIT_DEPTH // 8)
MICROSECONDS_PER_SECOND = 1_000_000

AUDIO_FORMAT = SupportedAudioFormat(
    codec=AudioCodec.OPUS,
    sample_rate=SAMPLE_RATE,
    bit_depth=BIT_DEPTH,
    channels=CHANNELS,
)

SIGNAL_ENABLED = {{ 'True' if streamer_sendspin_signal_enabled else 'False' }}
SIGNAL_THRESHOLD = {{ streamer_sendspin_signal_threshold }}
SIGNAL_PROBE_MS = {{ streamer_sendspin_signal_probe_ms }}
SIGNAL_DEBOUNCE_MS = {{ streamer_sendspin_signal_debounce_ms }}
SIGNAL_DEBOUNCE_S = SIGNAL_DEBOUNCE_MS / 1000

PROBE_FRAMES = SAMPLE_RATE * SIGNAL_PROBE_MS // 1000
PROBE_BYTES = PROBE_FRAMES * FRAME_STRIDE


def rms_of(payload: bytes) -> float:
    if len(payload) < 2:
        return 0.0
    samples = struct.unpack(f"<{len(payload) // 2}h", payload)
    return math.sqrt(sum(s * s for s in samples) / len(samples)) / 32768.0


def load_identity() -> Identity:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    identity_file = STATE_DIR / "identity.json"
    if identity_file.exists():
        data = json.loads(identity_file.read_text())
        return Identity.from_private_bytes(base64.b64decode(data["private_b64u"]))
    identity = Identity.generate()
    identity_file.write_text(json.dumps({"private_b64u": base64.b64encode(identity.private_bytes).decode()}))
    return identity


async def show_pin(pin: str | None, grouped: str | None = None) -> None:
    if pin is not None:
        if grouped and grouped != pin:
            logger.info("Pairing required: enter PIN %s (%s) in Music Assistant", pin, grouped)
        else:
            logger.info("Pairing required: enter PIN %s in Music Assistant", pin)


class SourceClient:
    def __init__(self) -> None:
        self._client: SendspinClient | None = None
        self._capture = None
        self._feed_task: asyncio.Task | None = None
        self._arecord: asyncio.subprocess.Process | None = None
        self._lock = asyncio.Lock()
        self._anchor_us = 0
        self._signal_task: asyncio.Task | None = None
        self._signal_active_prev: bool | None = None
        self._signal_since = 0.0
        self._signal_reported: SignalState | None = None

    async def build_client(self) -> SendspinClient:
        store = await FileClientPairingStore.open(STATE_DIR / "pairing")
        return SendspinClient(
            identity=load_identity(),
            client_name=CLIENT_NAME,
            roles=[Roles.SOURCE],
            pairing_store=store,
            pairing_support=PairingSupport(pairing_code_display=show_pin),
            source_support=ClientHelloSourceSupport(
                features=ClientHelloSourceFeatures(line_sense={{ 'True' if streamer_sendspin_signal_enabled else 'False' }})
            ),
        )

    def _on_command(self, payload: ServerCommandPayload) -> None:
        if payload.source is None:
            return
        command = payload.source.command
        if command == "start":
            asyncio.get_running_loop().create_task(self._start_capture())
        elif command == "stop":
            asyncio.get_running_loop().create_task(self._stop_capture())

    async def _start_capture(self) -> None:
        if self._feed_task is not None and not self._feed_task.done():
            return
        async with self._lock:
            if self._feed_task is not None and not self._feed_task.done():
                return
            client = self._client
            if client is None or not client.connected:
                return
            capture = client.create_source_capture(AUDIO_FORMAT)
            await capture.start()
            logger.info("Source stream started")
            self._anchor_us = 0
            proc = await asyncio.create_subprocess_exec(
                "arecord",
                "-D",
                ALSA_DEVICE,
                "-f",
                "S16_LE",
                "-r",
                str(SAMPLE_RATE),
                "-c",
                str(CHANNELS),
                "-t",
                "raw",
                stdout=asyncio.subprocess.PIPE,
            )
            self._capture = capture
            self._arecord = proc
            self._feed_task = asyncio.get_running_loop().create_task(self._pump(capture, proc))

    async def _pump(self, capture, proc: asyncio.subprocess.Process) -> None:
        buffer = bytearray()
        try:
            while True:
                chunk = await proc.stdout.read(4096)
                if not chunk:
                    break
                buffer.extend(chunk)
                frames = len(buffer) // FRAME_STRIDE
                if not frames:
                    continue
                payload = bytes(buffer[: frames * FRAME_STRIDE])
                del buffer[: frames * FRAME_STRIDE]
                if not self._anchor_us:
                    self._anchor_us = self._client.now_us()
                else:
                    self._anchor_us += frames * MICROSECONDS_PER_SECOND // SAMPLE_RATE
                if SIGNAL_ENABLED:
                    await self._observe_level(rms_of(payload) >= SIGNAL_THRESHOLD)
                await capture.feed(payload, capture_timestamp_us=self._anchor_us)
        except asyncio.CancelledError:
            raise
        except Exception:
            logger.exception("Capture feed error")
            await self._stop_capture()
        finally:
            if proc.returncode is None:
                proc.terminate()
            await proc.wait()
            logger.info("arecord exited (rc=%s)", proc.returncode)

    async def _stop_capture(self) -> None:
        async with self._lock:
            feed_task = self._feed_task
            capture = self._capture
            self._feed_task = None
            self._capture = None
        if feed_task is not None:
            feed_task.cancel()
            try:
                await feed_task
            except asyncio.CancelledError:
                pass
        if capture is not None:
            try:
                await capture.stop()
            except Exception:
                logger.exception("Source stream stop error")
            logger.info("Source stream stopped")
        self._anchor_us = 0

    async def _probe_active(self) -> bool:
        try:
            proc = await asyncio.create_subprocess_exec(
                "arecord",
                "-D",
                ALSA_DEVICE,
                "-f",
                "S16_LE",
                "-r",
                str(SAMPLE_RATE),
                "-c",
                str(CHANNELS),
                "-t",
                "raw",
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.DEVNULL,
            )
        except FileNotFoundError:
            logger.exception("Signal probe failed: arecord missing")
            return False
        buf = bytearray()
        try:
            while len(buf) < PROBE_BYTES:
                chunk = await proc.stdout.read(4096)
                if not chunk:
                    break
                buf.extend(chunk)
        except Exception:
            logger.exception("Signal probe read failed")
        finally:
            if proc.returncode is None:
                proc.terminate()
            await proc.wait()
        return rms_of(bytes(buf)) >= SIGNAL_THRESHOLD

    async def _report_signal(self, state: SignalState) -> None:
        client = self._client
        if client is None or not client.connected:
            return
        connection = client._admitted_connection  # noqa: SLF001
        if connection is None:
            return
        try:
            await connection.send_source_signal(state)
        except Exception:
            logger.exception("Failed to report source signal %s", state.value)
            return
        self._signal_reported = state
        logger.info("Reported source signal: %s", state.value)

    async def _observe_level(self, active: bool) -> None:
        if not SIGNAL_ENABLED:
            return
        now = asyncio.get_running_loop().time()
        if active == self._signal_active_prev:
            if now - self._signal_since < SIGNAL_DEBOUNCE_S:
                return
            desired = SignalState.PRESENT if active else SignalState.ABSENT
            if desired != self._signal_reported:
                await self._report_signal(desired)
            return
        self._signal_active_prev = active
        self._signal_since = now

    async def _signal_monitor(self) -> None:
        if not SIGNAL_ENABLED:
            return
        while True:
            if self._capture is not None:
                await asyncio.sleep(0.25)
                continue
            async with self._lock:
                try:
                    await self._observe_level(await self._probe_active())
                except Exception:
                    logger.exception("Signal probe failed")
            await asyncio.sleep(SIGNAL_PROBE_MS / 1000)

    async def run(self) -> int:
        main_task = asyncio.current_task()

        def shutdown() -> None:
            if main_task is not None:
                main_task.cancel()

        loop = asyncio.get_running_loop()
        for sig in (signal.SIGINT, signal.SIGTERM):
            with contextlib.suppress(NotImplementedError):
                loop.add_signal_handler(sig, shutdown)

        backoff = 1.0
        max_backoff = 60.0
        while True:
            try:
                client = await self.build_client()
                self._client = client
                subscription = client.add_server_command_listener(self._on_command)
                logger.info("Connecting to %s", SERVER)
                await client.connect(SERVER)
                logger.info("Connected (server: %s)", client.server_info.name if client.server_info else "?")
                self._signal_reported = None
                self._signal_active_prev = None
                self._signal_since = 0.0
                self._signal_task = asyncio.get_running_loop().create_task(self._signal_monitor())
                disconnect_event = asyncio.Event()
                unsub_disc = client.add_disconnect_listener(disconnect_event.set)
                await disconnect_event.wait()
                unsub_disc()
                subscription()
                if self._signal_task is not None:
                    self._signal_task.cancel()
                    try:
                        await self._signal_task
                    except asyncio.CancelledError:
                        pass
                    self._signal_task = None
                await self._stop_capture()
                await client.disconnect()
                self._client = None
                logger.info("Disconnected; reconnecting")
                backoff = 1.0
            except asyncio.CancelledError:
                await self._stop_capture()
                if self._signal_task is not None:
                    self._signal_task.cancel()
                if self._client is not None:
                    await self._client.disconnect()
                return 0
            except Exception as exc:
                logger.exception("Connection error (%s)", type(exc).__name__)
                await asyncio.sleep(backoff)
                backoff = min(backoff * 2, max_backoff)


if __name__ == "__main__":
    raise SystemExit(asyncio.run(SourceClient().run()))